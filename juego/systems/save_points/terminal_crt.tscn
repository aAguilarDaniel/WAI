; visibility_layer = 2 y el SubViewport solo mira la capa 1: asi la pantalla
; queda fuera de su propio encuadre y no hay recursion infinita.
; El hueco de crt_cuerpo.png mide 24x17 y empieza en (-12, -26). La imagen del
; circuito se genera al doble (48x34) para que no se pierda detalle al encuadrar.
[node name="Pantalla" type="Sprite2D" parent="."]
visibility_layer = 2
position = Vector2(-12, -26)
scale = Vector2(0.5, 0.5)
material = SubResource("Mat_crt")
centered = false

