; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Who Am I"
config/description="Plataformero 2D pixel art. Clase de Desarrollo de Videojuegos."
run/main_scene="res://ui/menu/menu_principal.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Alma="*res://autoload/alma.gd"
EstadoJuego="*res://autoload/estado_juego.gd"
Guardado="*res://autoload/guardado.gd"
DirectorAudio="*res://autoload/director_audio.gd"
CargadorEscenas="*res://autoload/cargador_escenas.gd"
Impacto="*res://autoload/impacto.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"

[gui]

theme/custom="res://ui/tema_wai.tres"

