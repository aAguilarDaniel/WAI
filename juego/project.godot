[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="jugador"
2d_physics/layer_3="enemigos"
2d_physics/layer_4="hitbox_jugador"
2d_physics/layer_5="hurtbox_jugador"
2d_physics/layer_6="hitbox_enemigo"
2d_physics/layer_7="hurtbox_enemigo"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
